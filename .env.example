PROJECT_NAME=自动化测试平台后端
VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/devtestbackend?charset=utf8mb4
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

JWT_SECRET_KEY=please-change-this-secret-key-for-devtestbackend
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://127.0.0.1:6379/0
DESKTOP_DEVICE_ACCESS_TOKEN_EXPIRE_MINUTES=15
DESKTOP_DEVICE_REFRESH_TOKEN_EXPIRE_DAYS=90
DESKTOP_HEARTBEAT_INTERVAL_SECONDS=20
DESKTOP_HEARTBEAT_PERSIST_SECONDS=60
DESKTOP_DEVICE_OFFLINE_AFTER_SECONDS=75
DESKTOP_REDIS_RETRY_SECONDS=5
DESKTOP_CONTROL_REDIS_CHANNEL_PREFIX=testauto:desktop:control:
DESKTOP_PRESENCE_REDIS_KEY_PREFIX=testauto:desktop:presence:
DESKTOP_MIN_VERSION=0.1.0
DESKTOP_MAX_CONCURRENCY=4
DESKTOP_SUPPORTED_DSL_VERSIONS=["ui-case-v1"]
DESKTOP_SUPPORTED_IPC_VERSIONS=["desktop-ipc-v1"]
UI_CASE_MAX_STEPS=200
UI_CASE_MAX_DSL_BYTES=1048576
UI_CASE_MAX_TAGS=50
UI_EXECUTION_LEASE_SECONDS=60
UI_EXECUTION_LEASE_RENEW_AFTER_SECONDS=20
UI_EXECUTION_EVENT_BATCH_MAX=100
UI_EXECUTION_EVENT_BATCH_MAX_BYTES=524288
UI_EXECUTION_EVENT_MAX_BYTES=16384
UI_EXECUTION_COMMAND_TTL_SECONDS=300
UI_EXECUTION_LEASE_SWEEP_ENABLED=true
UI_EXECUTION_LEASE_SWEEP_INTERVAL_SECONDS=10
UI_EXECUTION_LEASE_SWEEP_BATCH_SIZE=100
UI_EXECUTION_SSE_POLL_SECONDS=0.5
UI_EXECUTION_SSE_HEARTBEAT_SECONDS=15
UI_ARTIFACT_UPLOAD_EXPIRE_SECONDS=600
UI_ARTIFACT_DOWNLOAD_EXPIRE_SECONDS=300
UI_ARTIFACT_MAX_BYTES=536870912
UI_ARTIFACT_ALLOWED_CONTENT_TYPES=["image/png","image/jpeg","application/zip","application/json","application/octet-stream","text/plain","text/html","video/webm"]
UI_ARTIFACT_OBJECT_PREFIX=ui-executions
UI_ARTIFACT_CLEANUP_ENABLED=true
UI_ARTIFACT_CLEANUP_INTERVAL_SECONDS=300
UI_ARTIFACT_CLEANUP_BATCH_SIZE=100

# MinIO / S3-compatible media storage. Keep the bucket private.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=testplatform
MINIO_REGION=us-east-1
MINIO_SECURE=false
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_PRESIGNED_URL_EXPIRE_SECONDS=3600

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_STREAM_MAX_RETRIES=2
DEEPSEEK_STREAM_RETRY_BASE_SECONDS=0.5
DEEPSEEK_STREAM_RETRY_MAX_SECONDS=4
AGENT_RUN_STALE_TIMEOUT_SECONDS=900
TEST_PLAN_SCHEDULER_ENABLED=true
TEST_PLAN_SCHEDULER_INTERVAL_SECONDS=30
DASHBOARD_ASSET_SNAPSHOT_SCHEDULER_ENABLED=true
DASHBOARD_ASSET_SNAPSHOT_SCHEDULER_INTERVAL_SECONDS=300
TEST_PLAN_DEFAULT_TIMEZONE=Asia/Shanghai
TEST_PLAN_RUN_STALE_SECONDS=3600
TEST_PLAN_WEBHOOK_SECRET=
TEST_PLAN_WEBHOOK_MAX_AGE_SECONDS=300
SNAPSHOT_ENCRYPTION_KEY=
TEST_REPORT_EXPORT_EXPIRE_SECONDS=300

# Saved HTTP case execution safety. Private/loopback targets are blocked unless
# explicitly allowlisted (JSON array) or private-network access is enabled.
EXECUTION_RESPONSE_MAX_BYTES=1048576
EXECUTION_OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
EXECUTION_OUTBOUND_ALLOWED_HOSTS=[]
DATABASE_EXECUTION_ALLOW_PRIVATE_NETWORKS=false
DATABASE_EXECUTION_ALLOWED_HOSTS=[]

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
PLATFORM_WEB_BASE_URL=http://127.0.0.1:5174
